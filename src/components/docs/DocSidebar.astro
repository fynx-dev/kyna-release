---
import { docsSidebar, type SidebarGroup } from '../../config/docs-sidebar';

export interface Props {
  lang: string;
  currentSlug: string;
}

const { lang, currentSlug } = Astro.props;

const groups: SidebarGroup[] = docsSidebar[lang] || docsSidebar['en'] || [];

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const langPrefix = lang === 'en' ? '' : `/${lang}`;

function getItemUrl(link: string) {
  const cleanLink = link.replace(/^\//, '').replace(/\/$/, '');
  return `${baseUrl}${langPrefix}/docs/${cleanLink}/`;
}

function isActive(link: string) {
  const cleanLink = link.replace(/^\//, '').replace(/\/$/, '');
  const cleanSlug = currentSlug.replace(/^\//, '').replace(/\/$/, '');
  return cleanLink === cleanSlug;
}
---

<aside id="doc-sidebar" class="doc-sidebar">
  <nav class="sidebar-nav">
    {groups.map((group) => (
      <div class="sidebar-group">
        <div class="group-title">{group.text}</div>
        <ul class="group-items">
          {group.items.map((item) => {
            const active = isActive(item.link);
            return (
              <li>
                <a href={getItemUrl(item.link)} class={`sidebar-item ${active ? 'is-active' : ''}`}>
                  {item.title}
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    ))}
  </nav>
</aside>

<style>
  .doc-sidebar {
    width: 16rem;
    flex-shrink: 0;
    position: sticky;
    top: 3.75rem;
    height: calc(100vh - 3.75rem);
    overflow-y: auto;
    padding: 2.25rem 1.25rem 3rem 0;
    border-right: 1px solid color-mix(in oklch, var(--line) 30%, transparent);
  }

  .sidebar-group {
    margin-bottom: 1.75rem;
  }

  .group-title {
    font-size: 0.76rem;
    font-weight: 700;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0 0.5rem;
    margin-bottom: 0.6rem;
  }

  .group-items {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-item {
    display: block;
    padding: 0.45rem 0.65rem;
    font-size: 0.88rem;
    color: var(--muted);
    text-decoration: none;
    border-radius: 6px;
    transition: all 150ms ease;
  }

  .sidebar-item:hover {
    color: var(--mist);
    background: color-mix(in oklch, var(--ink-soft) 90%, transparent);
  }

  .sidebar-item.is-active {
    color: var(--accent);
    font-weight: 600;
    background: oklch(24% 0.035 181);
    border: 1px solid color-mix(in oklch, var(--accent) 30%, transparent);
  }

  @media (max-width: 860px) {
    .doc-sidebar {
      display: none;
    }
  }
</style>
