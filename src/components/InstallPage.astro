---
import type { InstallCopy } from '../i18n/types';
import LanguageSelect from './LanguageSelect.astro';

interface Props { copy: InstallCopy; }
const { copy } = Astro.props;
const asset = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\//, '')}`;
const releaseUrl = 'https://github.com/fynx-dev/kyna-release/releases/latest';
---
<a class="skip-link" href="#main">{copy.skip}</a>
<header class="site-header">
  <a class="brand" href={asset(copy.paths.home)}><img src={asset('assets/kyna-mark.svg')} alt="" width="30" height="30" /><span>Kyna Player</span></a>
  <LanguageSelect locale={copy.locale} isInstallPage={true} />
</header>
<main id="main" class="guide-page">
  <p class="eyebrow">Windows</p>
  <h1>{copy.heading}</h1>
  <p class="hero-lead">{copy.lead}</p>
  <a class="button button-primary" href={releaseUrl}>{copy.download}</a>
  {copy.sections.map((section) => <section><h2>{section.title}</h2><ol>{section.steps.map((step) => <li>{step}</li>)}</ol></section>)}
  <a class="text-link" href={asset(copy.paths.home)}>{copy.back}</a>
</main>
<footer class="site-footer"><a class="brand" href={asset(copy.paths.home)}><img src={asset('assets/kyna-mark.svg')} alt="" width="25" height="25" /><span>Kyna Player</span></a><p>Kyna Player for Windows</p></footer>
