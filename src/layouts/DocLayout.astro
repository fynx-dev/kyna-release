---
import BaseLayout from './BaseLayout.astro';
import LanguageSelect from '../components/LanguageSelect.astro';
import DocSidebar from '../components/docs/DocSidebar.astro';
import DocToc, { type Heading } from '../components/docs/DocToc.astro';
import DocBreadcrumb from '../components/docs/DocBreadcrumb.astro';
import DocFooterNav, { type NavItem } from '../components/docs/DocFooterNav.astro';

export interface Props {
  title: string;
  description?: string;
  lang: string;
  currentSlug: string;
  headings: Heading[];
  group?: string;
  prev?: NavItem;
  next?: NavItem;
  canonicalPath: string;
}

const {
  title,
  description = 'Kyna Player Documentation',
  lang,
  currentSlug,
  headings,
  group,
  prev,
  next,
  canonicalPath,
} = Astro.props;

const baseUrl = import.meta.env.BASE_URL.replace(/\/$/, '');
const homePath = lang === 'en' ? `${baseUrl}/` : `${baseUrl}/${lang}/`;
const feedbackUrl = 'https://github.com/fynx-dev/kyna-release/issues';

const navText: Record<string, { home: string; docs: string; feedback: string }> = {
  'en': { home: 'Home', docs: 'Docs', feedback: 'Feedback' },
  'zh-CN': { home: '首页', docs: '文档中心', feedback: '反馈' },
  'ja': { home: 'ホーム', docs: 'ドキュメント', feedback: 'フィードバック' },
  'ko': { home: '홈', docs: '문서', feedback: '피드백' },
};

const currentNav = navText[lang] || navText['en'];
---

<BaseLayout locale={lang} title={`${title} - Kyna Player`} description={description} canonicalPath={canonicalPath}>
  <!-- Header -->
  <header class="doc-site-header">
    <div class="header-inner">
      <a class="brand" href={homePath} aria-label="Kyna Player home">
        <img src={`${baseUrl}/assets/kyna-mark.svg`} alt="Kyna Player Logo" width="28" height="28" />
        <span class="brand-title">Kyna Player</span>
        <span class="doc-badge">Docs</span>
      </a>

      <nav class="header-nav" aria-label="Primary navigation">
        <a href={homePath} class="nav-link">{currentNav.home}</a>
        <a href={feedbackUrl} class="nav-link" target="_blank" rel="noopener noreferrer">{currentNav.feedback}</a>
        <LanguageSelect locale={lang as any} isInstallPage={false} docSlug={currentSlug} />
      </nav>
    </div>
  </header>

  <!-- Centered Max-Width Container with 3 Columns (Left Sidebar | Main Content | Right TOC) -->
  <div class="doc-page-container">
    <!-- Left Sidebar -->
    <DocSidebar lang={lang} currentSlug={currentSlug} />

    <!-- Center Main Content -->
    <main class="doc-main-content">
      <div class="doc-inner">
        <DocBreadcrumb lang={lang} group={group} title={title} />

        <header class="doc-header">
          <h1 class="doc-title">{title}</h1>
          {description && <p class="doc-lead">{description}</p>}
        </header>

        <article class="doc-prose">
          <slot />
        </article>

        <DocFooterNav prev={prev} next={next} lang={lang} />
      </div>
    </main>

    <!-- Right TOC Outline -->
    <DocToc headings={headings} lang={lang} />
  </div>
</BaseLayout>

<style>
  /* Header */
  .doc-site-header {
    position: sticky;
    top: 0;
    z-index: 900;
    width: 100%;
    height: 3.75rem;
    background: color-mix(in oklch, var(--ink) 85%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border-bottom: 1px solid color-mix(in oklch, var(--line) 35%, transparent);
  }

  .header-inner {
    width: min(100% - 2.5rem, 84rem);
    margin: 0 auto;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
  }

  .brand-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--mist);
    letter-spacing: -0.03em;
  }

  .doc-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.12rem 0.45rem;
    background: color-mix(in oklch, var(--accent) 15%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in oklch, var(--accent) 30%, transparent);
    border-radius: 999px;
    font-family: monospace;
  }

  .header-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .header-nav .nav-link {
    color: var(--muted);
    font-size: 0.88rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .header-nav .nav-link:hover {
    color: var(--accent);
  }

  /* Centered Max-Width 3-Column Page Layout Container */
  .doc-page-container {
    width: min(100% - 2.5rem, 84rem);
    margin: 0 auto;
    min-height: calc(100vh - 3.75rem);
    display: flex;
    gap: 2rem;
  }

  /* Center Main Content */
  .doc-main-content {
    flex: 1;
    min-width: 0;
    padding: 2.25rem 0 5rem;
  }

  .doc-inner {
    width: 100%;
  }

  .doc-header {
    margin-bottom: 2.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid color-mix(in oklch, var(--line) 35%, transparent);
  }

  .doc-title {
    font-family: var(--serif);
    font-size: clamp(1.5rem, 2.3vw, 1.85rem);
    font-weight: 500;
    color: var(--mist);
    margin-bottom: 0.6rem;
    line-height: 1.25;
    letter-spacing: -0.025em;
    text-wrap: balance;
  }

  .doc-lead {
    font-size: 0.98rem;
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  /* Markdown Article Typography & Elements */
  :global(.doc-prose) {
    line-height: 1.75;
    font-size: 0.96rem;
    color: var(--mist);
  }

  :global(.doc-prose h1) {
    font-family: var(--sans);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--mist);
    margin-top: 1.5rem;
    margin-bottom: 1rem;
    line-height: 1.3;
    text-wrap: balance;
  }

  :global(.doc-prose h2) {
    font-family: var(--sans);
    font-size: 1.22rem;
    font-weight: 700;
    color: var(--mist);
    margin-top: 2rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid color-mix(in oklch, var(--line) 35%, transparent);
    scroll-margin-top: 5rem;
    line-height: 1.35;
    text-wrap: balance;
  }

  :global(.doc-prose h3) {
    font-family: var(--sans);
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--mist);
    margin-top: 1.4rem;
    margin-bottom: 0.6rem;
    scroll-margin-top: 5rem;
    line-height: 1.35;
  }

  :global(.doc-prose h4) {
    font-family: var(--sans);
    font-size: 0.96rem;
    font-weight: 600;
    color: var(--mist);
    margin-top: 1.2rem;
    margin-bottom: 0.5rem;
  }

  :global(.doc-prose p) {
    margin-bottom: 1.15rem;
    color: color-mix(in oklch, var(--mist) 90%, var(--muted));
  }

  :global(.doc-prose ul),
  :global(.doc-prose ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.5rem;
    color: color-mix(in oklch, var(--mist) 90%, var(--muted));
  }

  :global(.doc-prose li) {
    margin-bottom: 0.85rem;
    line-height: 1.65;
  }

  :global(.doc-prose li > strong),
  :global(.doc-prose li > b) {
    color: var(--mist);
    font-weight: 600;
  }

  :global(.doc-prose a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 4px;
    transition: color 150ms ease;
  }

  :global(.doc-prose a:hover) {
    color: oklch(88% 0.12 180);
  }

  :global(.doc-prose blockquote) {
    border-left: 3px solid var(--accent);
    padding: 0.6rem 1rem;
    margin: 0 0 1.5rem 0;
    color: var(--muted);
    background: color-mix(in oklch, var(--ink-soft) 70%, transparent);
    border-radius: 0 8px 8px 0;
  }

  :global(.doc-prose code) {
    background: var(--ink-soft);
    color: var(--accent);
    padding: 0.2em 0.4em;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    border: 1px solid color-mix(in oklch, var(--line) 40%, transparent);
  }

  :global(.doc-prose pre) {
    background: var(--ink-soft) !important;
    border: 1px solid var(--line);
    border-radius: 10px;
    padding: 1.2rem;
    overflow-x: auto;
    margin-bottom: 1.5rem;
  }

  :global(.doc-prose pre code) {
    background: transparent;
    border: none;
    color: inherit;
    padding: 0;
  }

  :global(.doc-prose img) {
    border-radius: 10px;
    border: 1px solid var(--line);
    margin: 1.5rem 0;
    max-width: 100%;
    height: auto;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.45);
  }

  :global(.doc-prose table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.75rem;
    font-size: 0.92rem;
  }

  :global(.doc-prose th),
  :global(.doc-prose td) {
    border: 1px solid color-mix(in oklch, var(--line) 50%, transparent);
    padding: 0.65rem 0.9rem;
    text-align: left;
  }

  :global(.doc-prose th) {
    background: var(--ink-soft);
    color: var(--mist);
    font-weight: 600;
  }
</style>
