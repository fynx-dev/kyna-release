---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import { docsSidebar } from '../../config/docs-sidebar';

export async function getStaticPaths() {
  const allDocs = await getCollection('docs');
  
  const getCleanSlug = (d: any) => {
    const raw = d.slug || d.id.replace(/\.mdx?$/, '');
    return raw.replace(/^en\//, '');
  };

  const enDocs = allDocs.filter((doc) => doc.id.startsWith('en/') || (doc.slug && doc.slug.startsWith('en/')));

  const paths = enDocs.map((doc) => {
    const cleanSlug = getCleanSlug(doc);
    return {
      params: { slug: cleanSlug },
      props: { doc, cleanSlug },
    };
  });

  const indexDoc = enDocs.find((doc) => getCleanSlug(doc) === 'getting-started') || enDocs[0];
  if (indexDoc) {
    paths.push({
      params: { slug: undefined },
      props: { doc: indexDoc, cleanSlug: 'getting-started' },
    });
  }

  return paths;
}

const { doc, cleanSlug } = Astro.props;
const { Content, headings } = await render(doc);

// Calculate pagination prev/next from docsSidebar['en']
const sidebarGroups = docsSidebar['en'] || [];
const flatItems = sidebarGroups.flatMap((g) => g.items);
const currentIndex = flatItems.findIndex((item) => item.link === cleanSlug);

const prev = currentIndex > 0 ? flatItems[currentIndex - 1] : undefined;
const next = currentIndex >= 0 && currentIndex < flatItems.length - 1 ? flatItems[currentIndex + 1] : undefined;
---

<DocLayout
  title={doc.data.title}
  description={doc.data.description}
  lang="en"
  currentSlug={cleanSlug}
  headings={headings}
  group={doc.data.group}
  prev={prev}
  next={next}
  canonicalPath={`/docs/${cleanSlug}/`}
>
  <Content />
</DocLayout>
